{
  "version": "1.0.0",
  "router_settings": {
    "default_provider": "ollama_local",
    "health_check_interval_seconds": 30,
    "timeout_ms": 10000,
    "retry_attempts": 3,
    "fallback_enabled": true
  },
  "endpoints": {
    "ollama_local": {
      "name": "Local Ollama Endpoint",
      "base_url": "http://127.0.0.1:11434",
      "api_path": "/api/generate",
      "chat_api_path": "/api/chat",
      "tags_api_path": "/api/tags",
      "embeddings_api_path": "/api/embeddings",
      "status": "monitored"
    },
    "vllm_local": {
      "name": "Local vLLM / OpenAI Compatible",
      "base_url": "http://127.0.0.1:8000/v1",
      "status": "disabled"
    }
  },
  "model_routes": {
    "coding": {
      "primary": "qwen2.5-coder:latest",
      "fallbacks": ["codestral:latest", "llama3.1:8b-instruct", "mistral:7b-instruct"],
      "temperature": 0.2,
      "max_tokens": 4096
    },
    "general": {
      "primary": "llama3.1:latest",
      "fallbacks": ["qwen2.5:latest", "mistral:7b-instruct"],
      "temperature": 0.7,
      "max_tokens": 2048
    },
    "reasoning": {
      "primary": "deepseek-r1:8b",
      "fallbacks": ["qwen2.5-coder:latest", "llama3.1:latest"],
      "temperature": 0.4,
      "max_tokens": 4096
    },
    "embeddings": {
      "primary": "nomic-embed-text:latest",
      "fallbacks": ["all-minilm:latest", "mxbai-embed-large:latest"],
      "dimensions": 768
    }
  },
  "offline_strategy": {
    "cache_responses": true,
    "notify_user_on_offline": true,
    "mock_fallback_response": "Local LLM service (Ollama) is currently unreachable. Please verify Ollama is running (`ollama serve`)."
  }
}
